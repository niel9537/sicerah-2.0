                <p class="text-xs font-bold uppercase tracking-[.2em] text-amber-400">Bappelitbangda Kabupaten Nias Barat</p>
                <h2 class="mt-3 text-3xl sm:text-4xl font-extrabold tracking-tight">Perencanaan Berbasis Data Menuju Nias Barat CERAH.</h2>
                <p class="mt-4 text-sm sm:text-base leading-relaxed text-white/70">
                    SICERAH mendukung keterbukaan capaian pembangunan daerah, efektivitas evaluasi Renja OPD, penyajian dokumen regulasi perencanaan, serta visualisasi geospasial tematik untuk mewujudkan tata kelola pemerintahan yang akuntabel.
                </p>
                <div class="mt-6 flex items-center gap-4 text-xs font-semibold text-white/60">
                    <span>• Bersih</span>
                    <span>• Transparan</span>
                    <span>• Akuntabel</span>
                    <span>• Terukur</span>
                </div>
            </div>

            <div class="grid sm:grid-cols-2 gap-4">
                <a href="{{ route('webgis.index') }}" class="rounded-2xl bg-white/5 border border-white/10 p-5 hover:bg-white/10 hover:border-amber-400/50 transition duration-200 group">
                    <div class="w-10 h-10 rounded-xl bg-amber-600/30 text-amber-400 flex items-center justify-center mb-3 group-hover:scale-105 transition-transform">
                        <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 18l-6 3V6l6-3 6 3 6-3v15l-6 3-6-3zm0 0V3m6 18V6"/></svg>
                    </div>
                    <p class="font-bold text-white group-hover:text-amber-300 transition-colors">Peta Tematik Spasial</p>
                    <p class="text-xs text-white/55 mt-1 font-medium">Jelajahi sebaran data per desa & kecamatan</p>
                </a>

                <a href="{{ route('jdih.index') }}" class="rounded-2xl bg-white/5 border border-white/10 p-5 hover:bg-white/10 hover:border-amber-400/50 transition duration-200 group">
                    <div class="w-10 h-10 rounded-xl bg-amber-500/30 text-amber-300 flex items-center justify-center mb-3 group-hover:scale-105 transition-transform">
                        <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 12h6m-6 4h6m2 5H7a2 2 0 01-2-2V5a2 2 0 012-2h5.586a1 1 0 01.707.293l5.414 5.414a1 1 0 01.293.707V19a2 2 0 01-2 2z"/></svg>
                    </div>
                    <p class="font-bold text-white group-hover:text-amber-300 transition-colors">Dokumen JDIH</p>
                    <p class="text-xs text-white/55 mt-1 font-medium">Akses regulasi RPJMD & Renstra</p>
                </a>
            </div>
        </div>
    </section>

    {{-- ================= MODAL DETAIL INDIKATOR ================= --}}
    <div x-show="modalOpen" x-cloak class="indicator-modal-shell" role="dialog" aria-modal="true" aria-labelledby="indicator-modal-title" @keydown.escape.window="closeModal()">
        <div class="indicator-modal-backdrop" @click="closeModal()"></div>
        <div class="indicator-modal-panel p-6 sm:p-8">
            <div class="flex items-start justify-between gap-4">
                <div>
                    <div class="flex flex-wrap gap-2 mb-2.5">
                        <span class="badge-default">IKD</span>
                        <span x-show="selected?.is_iku" class="badge-maroon">IKU</span>
                        <span x-show="selected?.is_makro" class="badge-success">Makro</span>
                    </div>
                    <h3 id="indicator-modal-title" class="text-xl sm:text-2xl font-extrabold text-slate-900" x-text="selected?.nama"></h3>
                    <p class="text-sm text-slate-500 mt-1 font-medium" x-text="selected ? shortAspect(selected.aspek)+' · '+(selected.satuan || 'Tanpa satuan') : ''"></p>
                </div>
                <button type="button" @click="closeModal()" class="w-10 h-10 rounded-2xl bg-slate-100 hover:bg-slate-200 flex items-center justify-center text-slate-600 shrink-0 transition" aria-label="Tutup">
                    <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-width="2" d="M6 6l12 12M18 6 6 18"/></svg>
                </button>
            </div>

            <div x-show="selected?.has_chart" class="indicator-chart-wrap mt-6">
                <canvas id="indicatorTrendChart"></canvas>
            </div>

            <div x-show="selected && !selected.has_chart" class="mt-6 rounded-2xl bg-amber-50 border border-amber-200/80 p-5 text-sm text-amber-900 font-medium">
                Data indikator ini berupa narasi / teks kualitatif, sehingga ditampilkan sebagai tabel histori nilai tanpa grafik numerik.
            </div>

            <div class="mt-6 overflow-x-auto rounded-2xl border border-slate-100">
                <table class="w-full min-w-[620px] text-sm table-modern">
                    <thead>
                        <tr>
                            <th>Tahun</th>
                            <th>Jenis Nilai</th>
                            <th>Nilai Asli</th>
                            <th>Nilai Grafik</th>
                        </tr>
                    </thead>
                    <tbody>
                        <template x-for="point in (selected?.points || [])" :key="point.year">
                            <tr>
                                <td class="font-bold text-slate-900" x-text="point.year"></td>
                                <td class="capitalize font-medium text-slate-600" x-text="point.source || '—'"></td>
                                <td class="font-semibold text-slate-800" x-text="point.raw || '—'"></td>
                                <td class="font-bold text-amber-700" x-text="point.graph === null ? '—' : formatNumber(point.graph)"></td>
                            </tr>
                        </template>
                    </tbody>
                </table>
            </div>

            <p x-show="selected?.sumber_data" class="mt-5 text-xs leading-5 text-slate-500 font-medium">
                <span class="font-bold text-slate-700">Sumber Data:</span> <span x-text="selected?.sumber_data"></span>
            </p>
        </div>
    </div>
</div>
@endsection

@push('scripts')
<script src="https://cdn.jsdelivr.net/npm/chart.js@4.4.7/dist/chart.umd.min.js"></script>
<script>
    if (typeof Chart !== 'undefined') Chart.defaults.font.family = "'Plus Jakarta Sans', sans-serif";
    window.__SICERAH_INDICATORS__ = {{ Illuminate\Support\Js::from($indikatorDaerah) }};
    window.indicatorExplorer = function () {
        return {
            items: window.__SICERAH_INDICATORS__ || [], search: '', group: 'all', aspect: 'all', selected: null, modalOpen: false, chart: null,
            get filtered() {
                const query = this.search.trim().toLocaleLowerCase('id-ID');
                return this.items.filter((item) => {
                    const groupMatch = this.group === 'all' || (this.group === 'iku' && item.is_iku) || (this.group === 'makro' && item.is_makro);
                    const aspectMatch = this.aspect === 'all' || item.aspek === this.aspect;
                    const text = [item.nama, item.aspek, item.sumber_data, item.kode].filter(Boolean).join(' ').toLocaleLowerCase('id-ID');
                    return groupMatch && aspectMatch && (!query || text.includes(query));
                });
            },
            shortAspect(value) { return (value || 'Belum ada aspek').replace(/^ASPEK\s+/i, '').toLocaleLowerCase('id-ID').replace(/(^|\s)\S/g, (letter) => letter.toUpperCase()); },
            formatNumber(value) { return Number(value).toLocaleString('id-ID', { maximumFractionDigits: 4 }); },
            openIndicatorById(id) { const item = this.items.find((candidate) => String(candidate.id) === String(id)); if (item) this.openIndicator(item); },
            openIndicator(item) { this.selected = item; this.modalOpen = true; document.body.style.overflow = 'hidden'; this.$nextTick(() => this.renderChart()); },
            closeModal() { this.modalOpen = false; document.body.style.overflow = ''; if (this.chart) { this.chart.destroy(); this.chart = null; } },
            renderChart() {
                if (!this.selected?.has_chart || typeof Chart === 'undefined') return;
                const canvas = document.getElementById('indicatorTrendChart');
                if (!canvas) return;
                if (this.chart) this.chart.destroy();
                const points = this.selected.points;
                const datasets = [
                    {label:'Capaian',data:points.map((point)=>point.actual_graph),rawKey:'actual_raw',borderColor:'#d97706',backgroundColor:'#d97706',fill:false,tension:.25,spanGaps:false,pointRadius:5,pointHoverRadius:7,borderWidth:2.5},
                    {label:'Target',data:points.map((point)=>point.target_graph),rawKey:'target_raw',borderColor:'#f59e0b',backgroundColor:'#f59e0b',borderDash:[7,5],fill:false,tension:.25,spanGaps:false,pointRadius:5,pointHoverRadius:7,borderWidth:2.5}
                ].filter((dataset)=>dataset.data.some((value)=>value !== null && value !== undefined));
                this.chart = new Chart(canvas, {
                    type: 'line',
                    data: {
                        labels: points.map((point) => String(point.year)),
                        datasets,
                    },
                    options: {
                        responsive: true,
                        maintainAspectRatio: false,
                        interaction: { mode: 'index', intersect: false },
                        plugins: {
                            legend: {
                                display: true,
                                position: 'top',
                                align: 'start',
                                labels: { usePointStyle: true, boxWidth: 9, boxHeight: 9, padding: 18, font: { family: "'Plus Jakarta Sans', sans-serif", weight: '600' } },
                            },
                            tooltip: {
                                callbacks: {
                                    label: (context) => {
                                        const point = points[context.dataIndex];
                                        const raw = point[context.dataset.rawKey];
                                        return `${context.dataset.label}: ${raw ?? 'Belum tersedia'}${this.selected.satuan ? ` ${this.selected.satuan}` : ''}`;
                                    },
                                },
                            },
                        },
                        scales: {
                            y: { beginAtZero: false, grid: { color: 'rgba(226, 232, 240, 0.6)' }, ticks: { callback: (value) => Number(value).toLocaleString('id-ID') } },
                            x: { grid: { display: false } },
                        },
                    },
                });
            }
        };
    };

    document.addEventListener('DOMContentLoaded', function () {
        const element = document.getElementById('chartTrenLanding');
        if (!element || typeof Chart === 'undefined') return;
        new Chart(element, {
            type: 'bar',
            data: {
                labels: @json($tren['labels']),
                datasets: [{
                    label: 'Realisasi (Rp juta)',
                    data: @json($tren['realisasi']),
                    backgroundColor: ['#e2e8f0', '#fbbf24', '#d97706', '#78350f'],
                    borderRadius: 12
                }]
            },
            options: {
                responsive: true,
                maintainAspectRatio: false,
                plugins: {
                    legend: { display: false }
                },
                scales: {
                    x: { grid: { display: false } },
                    y: { beginAtZero: true, grid: { color: 'rgba(226, 232, 240, 0.6)' }, ticks: { callback: (value) => Number(value).toLocaleString('id-ID') } }
                }
            }
        });
    });
</script>
@endpush
